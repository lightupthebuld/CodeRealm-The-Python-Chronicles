<%- include('../partials/header', { title: title, extraCSS: ['player.css'] }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="container" style="padding-top: var(--space-2xl);">
        <div class="page-header" style="justify-content: center; border: none;">
            <h1>🏁 Game Result</h1>
        </div>

        <div class="result-card animate-slide-up">
            <div class="result-icon">🏆</div>
            <h2 style="color: var(--accent-light);">Game Over!</h2>
            <p>The adventure has ended. Here are the final standings:</p>
            <div style="margin-top: var(--space-xl); width: 100%;">
                <table class="data-table" style="font-size: 0.9rem;">
                    <thead>
                        <tr><th>Rank</th><th>Player</th><th>Score</th><th>Status</th></tr>
                    </thead>
                    <tbody id="standings-body">
                        <!-- Populated dynamically -->
                    </tbody>
                </table>
            </div>
        </div>

        <div class="result-actions">
            <a href="/" class="btn btn-primary btn-lg" id="btn-back-lobby">🏠 Back to Lobby</a>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const gameOverDataStr = sessionStorage.getItem('gameOverData');
        const tbody = document.getElementById('standings-body');
        
        if (gameOverDataStr) {
            const data = JSON.parse(gameOverDataStr);
            const reasonEl = document.createElement('h3');
            reasonEl.style.color = 'var(--primary-color)';
            reasonEl.style.marginBottom = 'var(--space-md)';
            reasonEl.textContent = data.reason;
            document.querySelector('.result-card h2').after(reasonEl);
            
            data.standings.forEach(p => {
                const tr = document.createElement('tr');
                let rankDisplay = p.rank;
                if (p.rank === 1) rankDisplay = '🥇 1';
                else if (p.rank === 2) rankDisplay = '🥈 2';
                else if (p.rank === 3) rankDisplay = '🥉 3';
                
                const statusStr = p.alive ? '<span style="color:var(--success);">Survived</span>' : '<span style="color:var(--danger);">Eliminated</span>';
                
                tr.innerHTML = `<td>${rankDisplay}</td><td>${p.username}</td><td>${p.score}</td><td>${statusStr}</td>`;
                tbody.appendChild(tr);
            });
            
            // Clear it so a refresh doesn't hold old data indefinitely
            sessionStorage.removeItem('gameOverData');
        } else {
            tbody.innerHTML = '<tr><td colspan="4">No game data found.</td></tr>';
        }
    });
</script>

<%- include('../partials/footer', { extraJS: [] }) %>
