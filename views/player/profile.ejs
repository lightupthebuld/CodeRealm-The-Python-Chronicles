<%- include('../partials/header', { title: title, extraCSS: ['player.css'] }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="container">
        <div class="page-header">
            <a href="/" class="btn-back" id="btn-back">← Back</a>
            <h1>👤 Profile</h1>
        </div>

        <div class="profile-card animate-slide-up">
            <div style="text-align: center; margin-bottom: var(--space-xl);">
                <div class="profile-avatar">👤</div>
                <h2 style="margin-bottom: var(--space-xs);"><%= user ? user.username : 'Player' %></h2>
                <p style="color: var(--text-muted);"><%= user ? user.email : 'player@coderealm.com' %></p>
            </div>

            <div style="margin-bottom: var(--space-xl);">
                <div class="form-group">
                    <label class="form-label" style="font-size: 0.9rem;">Username</label>
                    <p style="font-size: 1.1rem; color: var(--text-primary);"><%= user ? user.username : 'Player' %></p>
                </div>
                <div class="form-group">
                    <label class="form-label" style="font-size: 0.9rem;">Email</label>
                    <p style="font-size: 1.1rem; color: var(--text-primary);"><%= user ? user.email : 'player@coderealm.com' %></p>
                </div>
                <div class="form-group">
                    <label class="form-label" style="font-size: 0.9rem;">Role</label>
                    <p style="font-size: 1.1rem; color: var(--primary-light); font-weight: 600;"><%= user ? (user.role === 'admin' ? 'Admin' : 'Player') : 'Player' %></p>
                </div>
            </div>

            <div class="action-buttons" style="display: flex; gap: var(--space-md);">
                <a href="/profile/edit" class="btn btn-primary" style="flex: 1; justify-content: center;">✏️ Edit Profile</a>
                <form action="/auth/logout" method="POST" style="flex: 1;">
                    <button type="submit" class="btn btn-outline" style="width: 100%;">🚪 Logout</button>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer', { extraJS: [] }) %>
