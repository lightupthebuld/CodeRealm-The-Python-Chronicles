<%- include('../partials/header', { title: title, extraCSS: ['player.css'] }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="container">
        <div class="page-header">
            <a href="/" class="btn-back" id="btn-back">← Back</a>
            <h1>📦 Physical Component</h1>
        </div>

        <div class="download-grid animate-slide-up" style="display: flex; flex-direction: column; gap: 20px;">
            <div class="download-card" style="text-align: center;">
                <h3>🗺️ Game Map</h3>
                <div class="download-preview" style="margin: 10px auto;">
                    <img src="<%= components.mapImage %>" alt="CodeRealm Game Map" style="max-width: 100%; max-height: 400px; border-radius: 8px; border: 2px solid var(--primary-color);">
                </div>
                <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 10px;">Download the physical game board map.</p>
                <a href="<%= components.mapImage %>" download="CodeRealm_Map.png" class="btn btn-primary" id="btn-download-map">📥 Download Map</a>
            </div>

            <div class="download-card" style="text-align: center;">
                <h3>🃏 QR Cards (Printable)</h3>
                <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 20px;">Print these QR cards and place them on the board tiles. Scan them in-game to trigger events.</p>
                
                <div style="display: flex; flex-wrap: wrap; gap: 20px; justify-content: center;">
                    <% components.qrCards.forEach(card => { %>
                    <div style="background: var(--bg-surface); padding: 15px; border-radius: 8px; border: 1px solid var(--border); text-align: center; flex: 1; min-width: 200px;">
                        <h4 style="color: var(--text-color); margin-bottom: 10px;"><%= card.title %></h4>
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(card.data) %>" alt="<%= card.title %> QR" style="display: block; margin: 0 auto; margin-bottom: 10px;" />
                        <p style="color: var(--text-muted); font-size: 0.75rem;"><%= card.description %></p>
                        <p style="color: rgba(255, 255, 255, 0.4); font-size: 0.7rem; margin-bottom: 10px;">Data: <%= card.data %></p>
                        <a href="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(card.data) %>" target="_blank" download="QR_<%= card.id %>.png" class="btn btn-primary btn-sm" style="padding: 5px 10px; font-size: 0.8rem;">📥 Download</a>
                    </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer', { extraJS: [] }) %>
