<%- include('../partials/header', { title: title, extraCSS: ['admin.css'] }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
    <div class="container">
        <div class="page-header">
            <a href="/admin/dashboard" class="btn-back">← Dashboard</a>
            <h1>📦 Physical Components Management</h1>
        </div>

        <%- include('../partials/alerts') %>

        <div class="admin-card animate-slide-up">
            <h3>🗺️ Update Game Map</h3>
            <form action="/admin/components/map" method="POST">
                <div class="form-group">
                    <label for="mapImage">Map Image URL / Path</label>
                    <input type="text" id="mapImage" name="mapImage" class="form-control" value="<%= components.mapImage %>" required>
                </div>
                <button type="submit" class="btn btn-primary">Save Map</button>
            </form>
        </div>

        <div class="admin-card animate-slide-up" style="margin-top: 20px;">
            <h3>🃏 Add New QR Card</h3>
            <form action="/admin/components/qr/add" method="POST">
                <div class="form-group">
                    <label for="id">Card ID (Unique, e.g., event_heal)</label>
                    <input type="text" id="id" name="id" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="title">Title (e.g., 💖 Heal Event)</label>
                    <input type="text" id="title" name="title" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="data">QR Data (e.g., TILE-HEAL)</label>
                    <input type="text" id="data" name="data" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <input type="text" id="description" name="description" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary">Add QR Card</button>
            </form>
        </div>

        <div class="admin-card animate-slide-up" style="margin-top: 20px;">
            <h3>🃏 Current QR Cards</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px;">
                <% components.qrCards.forEach(card => { %>
                <div style="background: var(--bg-surface); padding: 15px; border-radius: 8px; border: 1px solid var(--border); text-align: center; flex: 1; min-width: 200px; position: relative;">
                    <form action="/admin/components/qr/delete/<%= card.id %>" method="POST" style="position: absolute; top: 10px; right: 10px;">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this QR card?');">✖</button>
                    </form>
                    <h4 style="color: var(--text-color); margin-bottom: 10px;"><%= card.title %></h4>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=<%= encodeURIComponent(card.data) %>" alt="<%= card.title %> QR" style="display: block; margin: 0 auto; margin-bottom: 10px;" />
                    <p style="color: var(--text-muted); font-size: 0.75rem;"><%= card.description %></p>
                    <p style="color: rgba(255, 255, 255, 0.4); font-size: 0.7rem; margin-bottom: 10px;">Data: <%= card.data %></p>
                </div>
                <% }) %>
            </div>
        </div>
        </div>
    </div>
</main>

<%- include('../partials/footer', { extraJS: [] }) %>
