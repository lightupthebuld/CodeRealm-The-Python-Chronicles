<%- include('../partials/header', { title: title, extraCSS: ['admin.css'] }) %>
    <%- include('../partials/navbar') %>

        <main class="main-content">
            <div class="container">
                <div class="page-header">
                    <a href="/admin/questions" class="btn-back" id="btn-back">← Back</a>
                    <h1>➕ Admin – Add Question</h1>
                </div>

                <div class="form-card animate-slide-up">
                    <form id="add-question-form" action="/admin/questions/add" method="POST" novalidate>
                        <div class="question-form-layout">
                            <div class="form-group">
                                <label for="questiontext" class="form-label">Question</label>
                                <textarea class="form-control" id="questiontext" name="questiontext" rows="5"
                                    placeholder="Enter the question text..." required></textarea>
                            </div>
                            <div class="upload-area">
                                <div class="picture-preview" id="picture-preview">
                                    📷 Picture Preview
                                </div>
                                <label class="btn btn-outline btn-sm" style="cursor: pointer; text-align: center;">
                                    📤 Picture Upload
                                    <input type="file" id="picture-upload" name="picture" accept="image/*"
                                        style="display: none;">
                                </label>
                            </div>
                        </div>

                        <div class="form-row" style="margin-top: var(--space-lg);">
                            <div class="form-group">
                                <label for="concept" class="form-label">Concept</label>
                                <select class="form-control" id="concept" name="concept">
                                    <option value="if_else">If/Else Statements (Decision Path)</option>
                                    <option value="loops">Loops - For/While (Endless Cycle)</option>
                                    <option value="switch">Switch/Case (Multiple Choices)</option>
                                    <option value="exceptions">Exception Handling (Error Trap)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="difficulty" class="form-label">Difficulty</label>
                                <select class="form-control" id="difficulty" name="difficulty">
                                    <option value="easy">Easy</option>
                                    <option value="medium" selected>Medium</option>
                                    <option value="hard">Hard</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Answer Options</label>
                            <div class="answer-grid">
                                <div class="answer-option">
                                    <span class="option-label">A</span>
                                    <input type="text" class="form-control" id="option-a" name="option_a"
                                        placeholder="Option A" required>
                                    <div class="correct-indicator">
                                        <input type="radio" name="correct" value="A" id="correct-a"> <label
                                            for="correct-a"
                                            style="font-size:0.8rem; color:var(--text-muted);">Correct</label>
                                    </div>
                                </div>
                                <div class="answer-option">
                                    <span class="option-label">B</span>
                                    <input type="text" class="form-control" id="option-b" name="option_b"
                                        placeholder="Option B" required>
                                    <div class="correct-indicator">
                                        <input type="radio" name="correct" value="B" id="correct-b"> <label
                                            for="correct-b"
                                            style="font-size:0.8rem; color:var(--text-muted);">Correct</label>
                                    </div>
                                </div>
                                <div class="answer-option">
                                    <span class="option-label">C</span>
                                    <input type="text" class="form-control" id="option-c" name="option_c"
                                        placeholder="Option C" required>
                                    <div class="correct-indicator">
                                        <input type="radio" name="correct" value="C" id="correct-c"> <label
                                            for="correct-c"
                                            style="font-size:0.8rem; color:var(--text-muted);">Correct</label>
                                    </div>
                                </div>
                                <div class="answer-option">
                                    <span class="option-label">D</span>
                                    <input type="text" class="form-control" id="option-d" name="option_d"
                                        placeholder="Option D" required>
                                    <div class="correct-indicator">
                                        <input type="radio" name="correct" value="D" id="correct-d"> <label
                                            for="correct-d"
                                            style="font-size:0.8rem; color:var(--text-muted);">Correct</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div style="text-align: right; margin-top: var(--space-xl);">
                            <button type="submit" class="btn btn-primary btn-lg" id="btn-add">➕ Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <script>
            document.getElementById('picture-upload').addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        document.getElementById('picture-preview').innerHTML = '<img src="' + e.target.result + '" alt="Preview">';
                    };
                    reader.readAsDataURL(file);
                }
            });
        </script>

        <%- include('../partials/footer', { extraJS: [] }) %>